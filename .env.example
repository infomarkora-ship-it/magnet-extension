# Required
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Needed for Haiku scoring, openers and reply drafts (everything else works without it)
ANTHROPIC_API_KEY=
# Railway: mount a volume at /data and keep this path so your data survives deploys
DB_PATH=/data/magnetengine.db
# Optional
HAIKU_MODEL=claude-haiku-5-5
HAIKU_DAILY_TOKEN_CAP=400000
DEFAULT_TZ=America/New_York
PUBLIC_URL=
